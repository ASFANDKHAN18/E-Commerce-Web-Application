@model List<byhands.Models.CartItem>
@{
    ViewBag.Title = "Index";
    var subtotal = Model.Sum(x => x.Total);
    var shipping = 250;
    var grandtotal = subtotal + shipping;

}

<div id="columns" class="columns-container">
    <!-- container -->
    <div class="container">
        <div id="order-detail-content" class="table_block table-responsive">
            <table id="cart_summary" class="table table-bordered">
                <thead>
                    <tr>
                        <th class="cart_delete last_item">&nbsp;</th>
                        <th class="cart_product first_item">Product</th>
                        <th class="cart_description item">Description</th>
                        <th class="cart_unit item text-right">Unit price</th>
                        <th class="cart_quantity item text-center">Qty</th>
                        <th class="cart_total item text-right">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                    <tr>
                        <td class="cart_delete text-center">
                            <a title="Remove this item" class="remove" href="@Url.Action("Remove", "Cart", new {id =item.BouquetId})">
                                <i class="fa fa-times"></i>
                            </a>
                        </td>
                        <td class="cart_product">
                            <a href="page-detail.html">
                                <img width="80" height="107" alt="" class="img-responsive" src="@Url.Content(item.ImageUrl)">
                            </a>
                        </td>
                        <td class="cart_description">
                            <a href="page-detail-wines.html">@item.BouquetName</a>
                        </td>
                        <td class="cart_unit text-right">
                            <span class="amount">@item.Price</span>
                        </td>
                        <td class="cart_quantity text-center">
                            <div class="quantity">
                                <a href="@Url.Action("Decrease", "Cart", new { id = item.BouquetId })" class="minus">-</a>
                                <input type="text" class="input-text qty text" title="Qty" value="@item.Quantity" name="quantity">
                                <a href="@Url.Action("Increase", "Cart", new { id = item.BouquetId })" class="plus">+</a>
                            </div>
                        </td>
                        <td class="cart_total text-right">
                          @item.Total
                        </td>
                    </tr>}

                </tbody>
                <tfoot>
                    <tr>
                        <td rowspan="3" colspan="3"></td>
                        <td colspan="2" class="text-right">Total products</td>
                        <td colspan="1" class="price text-right" id="total_product">@subtotal</td>
                    </tr>
                    <tr class="cart_total_delivery">
                        <td colspan="2" class="text-right">Total shipping</td>
                        <td colspan="1" class="price text-right" id="total_shipping">@shipping</td>
                    </tr>
                    <tr class="cart_total_price">
                        <td colspan="2" class="total_price_container text-right">
                            <span>Total</span>
                            <div class="hookDisplayProductPriceBlock-price"></div>
                        </td>
                        <td colspan="1" class="price text-right" id="total_price_container">
                            <span id="total_price">@grandtotal</span>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div><!-- end order-detail-content -->
        <div class="cart_navigation">
            @if (Session["UserId"] == null)
            {
                <a href="@Url.Action("Login", "Account")"
                   class="button btn btn-primary standard-checkout pull-right">
                    Login to Checkout
                </a>
            }
            else
            {
                <a href="@Url.Action("Index", "Checkout")"
                   class="button btn btn-primary standard-checkout pull-right">
                    Proceed to Checkout
                </a>
            }



            
        
        </div><!-- end cart_navigation -->
    </div> <!-- end container -->
</div><!--end columns -->
